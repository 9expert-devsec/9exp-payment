# Copy this file to .env.local (gitignored) and fill in real values.
# NEVER commit real secrets. Only this placeholder template is committed.

# MongoDB — shares an Atlas cluster with 9exp_genesis; the two apps are
# separated by DATABASE NAME, not by cluster. The URI intentionally has NO
# database path segment (no "/9exp_payment" before the "?"), so moving to a
# dedicated cluster later is a URI change with zero code edits. The database
# is selected in code from MONGODB_DB_NAME.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB_NAME=9exp_payment
# Mongoose defaults to a 100-connection pool; multiplied across warm Lambdas
# that exhausts the cluster. Keep this small (M0 = 500 cap). Retune per tier
# without a redeploy by changing this env var.
MONGO_MAX_POOL_SIZE=3

# MSDB read-only catalogue API (strictly read-only; never written to)
AI_API_BASE=https://9exp-sec.com/api/ai
AI_API_KEY=

# Shared secret guarding POST /api/admin/sync-courses until Phase 2 auth lands.
# Send it as the "x-sync-secret" request header.
SYNC_SECRET=

# NextAuth v5 (admin auth). AUTH_SECRET: a 32-byte random string
# (e.g. `openssl rand -base64 32`). AUTH_URL: the app's base URL — localhost for
# dev, the real deployed URL in Vercel. Set BOTH in Vercel env vars too.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
